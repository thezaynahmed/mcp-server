    {
      "name": "calculate_finops_roi",
      "description": "Calculate estimated cloud cost savings and ROI from Karpenter container bin-packing, spot orchestration, and Graviton migration.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
