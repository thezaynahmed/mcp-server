    {
      "name": "submit_contact",
      "description": "Dispatch an encrypted engineering inquiry or consultation request directly to Zain Ahmed with tracking reference ID.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "inputSchema": {
        "type": "object",
